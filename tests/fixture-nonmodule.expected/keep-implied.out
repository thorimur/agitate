Fixture/BinderUse.lean:
  remove #[import Fixture.BinderA]
Fixture/EqnUse.lean:
  remove #[import Fixture.EqnRealize]
  add #[import Fixture.Eqns]
Fixture/Missing.lean:
  remove #[import Fixture.C]
  add #[import Fixture.A]
Fixture/PrefixUse.lean:
  remove #[import Fixture.Pre]
  add #[import Fixture.Pre.Impl]
Fixture/Unused.lean:
  remove #[import Fixture.C]
